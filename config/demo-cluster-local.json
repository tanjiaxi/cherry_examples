{
  "env": "gc",
  "debug": true,
  "print_level": "Debug",
  "cluster": {
    "discovery": {
      "mode": "etcd",
      "@mode1": "mode=default,从profile-{x}.json读取node节点的配置数据",
      "@mode2": "mode=nats,通过nats->master_node_id获取已注册的节点",
      "@mode3": "mode=etcd,通过etcd同步已注册节点"
    },
    "nats": {
      "master_node_id": "gc-master",
      "address": "nats://10.10.10.251:4222",
      "reconnect_delay": 1,
      "max_reconnects": 0,
      "request_timeout": 20,
      "user": "",
      "password": "",
      "pool_size": 10
    },
    "etcd": {
        "end_points": "10.10.10.251:2379",
        "@end_points": "10.10.10.251:2379,dev1.com:2379",
        "prefix" : "cherry",
        "ttl": 1000,
        "dial_timeout": 3,
        "dial_keep_alive_time": 1,
        "dial_keep_alive_timeout": 1,
        "user": "",
        "password": ""
    }
  },
  "node": {
    "master": [
      {
        "node_id": "gc-master",
        "address": "",
        "__settings__": {
          "ref_logger": "master_log"
        },
        "enable": true
      }
    ],
    "center": [
      {
        "node_id": "gc-center",
        "address": "",
        "__settings__": {
          "ref_logger": "center_log",
          "db_id_list": {
            "center_db_id": "center_db_1"
          }
        },
        "enable": true
      }
    ],
    "gate": [
      {
        "node_id": "gc-gate-1",
        "address": "0.0.0.0:10010",
        "__settings__": {
          "db_id_list" : {
            "center_db_id": "game_db_1"
          },
          "tcp_address": "0.0.0.0:20010",
          "ref_logger": "gate_log",
          "call_time_out":"1"

        },
        "enable": true
      },
      {
        "node_id": "gc-gate-2",
        "address": "0.0.0.0:10011",
        "__settings__": {
          "db_id_list" : {
            "game_db_id": "game_db_1"
          },
          "tcp_address": "0.0.0.0:20011",
          "ref_logger": "gate_log",
          "call_time_out":"1"
        },
        "enable": true
      },
      {
        "node_id": "gc-gate-3",
        "address": "0.0.0.0:20012",
        "__settings__": {
          "db_id_list" : {
            "game_db_id": "game_db_1"
          },
          "tcp_address": "0.0.0.0:20012",
          "ref_logger": "gate_log",
          "call_time_out":"1"
        },
        "enable": true
      }
    ],
    "web": [
      {
        "node_id": "gc-web-1",
        "address": "0.0.0.0:8081",
        "__settings__": {
          "ref_logger": "web_log",
          "call_time_out": "10" 
        },
        "enable": true
      }
    ],
    "game": [
      {
        "node_id": "^\\d+$",
        "__settings__": {
          "db_id_list" : {
            "game_db_id": "game_db_1"
          },
          "ref_logger": "game_log"
        },
        "enable": true
      }
    ]
  },
  "logger": {
    "master_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    },
    "web_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    },
    "center_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    },
    "gate_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    },
    "game_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    },
    "cross_log": {
      "level": "Debug",
      "enable_console": false,
      "enable_write_file": true,
      "file_link_path": "logs/debug.log",
      "file_path_format": "logs/debug_%Y%m%d%H%M.log"
    }
  },
  "data_config": {
    "parser": "json",
    "data_source": "file",
    "file": {
      "file_path": "data/",
      "ext_name": ".json",
      "reload_time": 3000
    },
    "redis": {
      "prefix_key": "data_config",
      "subscribe_key": "data_config_change",
      "address": "10.10.10.251:6379",
      "password": "",
      "db": 7
    }
  },
  "db": {
    "center_db_group": [
      {
        "enable": true,
        "db_id": "center_db_1",
        "dsn" : "",
        "db_name": "classic_slots",
        "host": "10.10.10.251",
        "port": 5432,
        "user_name": "postgres",
        "password": "postgres",
        "max_idle_connect": 200,
        "max_open_connect": 200,
        "slow_threshold_ms": 20,
        "max_life_time_minute": 30,
        "max_Idle_time_minute": 10,
        "log_mode": false
      }
    ],
    "game_db_group": [
      {
        "enable": true,
        "db_id": "game_db_1",
        "dsn" : "",
        "db_name": "classic_slots",
        "host": "10.10.10.251",
        "port": 5432,
        "user_name": "postgres",
        "password": "postgres",
        "max_idle_connect": 200,
        "max_open_connect": 200,
        "slow_threshold_ms": 20,
        "max_life_time_minute": 30,
        "max_Idle_time_minute": 10,
        "log_mode": false
      }
    ]
  },
  "runtime_monitor": {
    "master": {
      "enabled": false,
      "collect_interval": 5,
      "print_interval": 60,
      "history_size": 120,
      "metrics_path": "/metrics",
      "metrics_port": 30010,
      "enable_alert": true
    },
    "center": {
      "enabled": false,
      "collect_interval": 5,
      "print_interval": 60,
      "history_size": 120,
      "metrics_path": "/metrics",
      "metrics_port": 30011,
      "enable_alert": true
    },
    "gate": {
      "enabled": false,
      "collect_interval": 5,
      "print_interval": 60,
      "history_size": 120,
      "metrics_path": "/metrics",
      "metrics_port": 30012,
      "enable_alert": true
    },
    "game": {
      "enabled": false,
      "collect_interval": 5,
      "print_interval": 60,
      "history_size": 120,
      "metrics_path": "/metrics",
      "metrics_port": 30013,
      "enable_alert": true
    },
    "web": {
      "enabled": false,
      "collect_interval": 5,
      "print_interval": 60,
      "history_size": 120,
      "metrics_path": "/metrics",
      "metrics_port": 30014,
      "enable_alert": true
    }
  }
}
